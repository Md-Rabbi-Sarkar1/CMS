generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Company is the tenant root. All company-owned entities carry a companyId.
model Company {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(255)
  slug        String        @unique @db.VarChar(100)
  logoUrl     String?       @map("logo_url") @db.VarChar(2048)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  users       User[]
  invitations Invitation[]
  projects    Project[]

  @@map("companies")
}

model User {
  id             String           @id @default(uuid()) @db.Uuid
  companyId      String           @map("company_id") @db.Uuid
  name           String           @db.VarChar(255)
  email          String           @db.VarChar(255)
  passwordHash   String           @map("password_hash") @db.VarChar(255)
  role           CompanyRole
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  company        Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  refreshTokens  RefreshToken[]
  projectMembers ProjectMember[]
  managedProjects Project[]       @relation("ProjectManager")
  assignedTasks  Task[]           @relation("TaskAssignee")

  @@unique([companyId, email])
  @@index([companyId])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedAt DateTime? @map("replaced_at") @db.Timestamptz(6)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([userId])
  @@map("refresh_tokens")
}

model Invitation {
  id         String           @id @default(uuid()) @db.Uuid
  companyId  String           @map("company_id") @db.Uuid
  email      String           @db.VarChar(255)
  role       CompanyRole
  tokenHash  String           @map("token_hash") @db.VarChar(255)
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz(6)
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  acceptedAt DateTime?        @map("accepted_at") @db.Timestamptz(6)
  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([email])
  @@index([expiresAt])
  @@map("invitations")
}

model Project {
  id                 String        @id @default(uuid()) @db.Uuid
  companyId          String        @map("company_id") @db.Uuid
  managerId          String?       @map("manager_id") @db.Uuid
  name               String        @db.VarChar(255)
  description        String?
  location           String?       @db.VarChar(255)
  clientInfo         String?       @map("client_info")
  startDate          DateTime?     @map("start_date") @db.Date
  expectedEndDate    DateTime?     @map("expected_end_date") @db.Date
  actualEndDate      DateTime?     @map("actual_end_date") @db.Date
  budget             Decimal?      @db.Decimal(12, 2)
  status             ProjectStatus @default(PLANNING)
  progressPercentage Int           @default(0) @map("progress_percentage") @db.SmallInt
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  company            Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  manager            User?         @relation("ProjectManager", fields: [managerId], references: [id])
  members            ProjectMember[]
  tasks              Task[]

  @@index([companyId])
  @@index([managerId])
  @@index([status])
  @@map("projects")
}

model ProjectMember {
  id         String   @id @default(uuid()) @db.Uuid
  projectId  String   @map("project_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id             String       @id @default(uuid()) @db.Uuid
  projectId      String       @map("project_id") @db.Uuid
  assigneeId     String?      @map("assignee_id") @db.Uuid
  title          String       @db.VarChar(255)
  description    String?
  priority       TaskPriority @default(MEDIUM)
  status         TaskStatus   @default(TODO)
  startDate      DateTime?    @map("start_date") @db.Date
  dueDate        DateTime?    @map("due_date") @db.Date
  completionDate DateTime?    @map("completion_date") @db.Date
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  project        Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([assigneeId])
  @@index([dueDate])
  @@index([priority])
  @@index([projectId])
  @@index([status])
  @@map("tasks")
}

enum CompanyRole {
  ADMIN
  PROJECT_MANAGER
  ENGINEER
  WORKER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  BLOCKED
  REVIEW
  COMPLETED
}
