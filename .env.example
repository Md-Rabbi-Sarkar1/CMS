# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/construction_ops?schema=public"

# API
PORT=4000
NODE_ENV=development
WEB_URL="http://localhost:3000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"

# Auth (Phase 5+)
JWT_ACCESS_SECRET=""
JWT_REFRESH_SECRET=""

# Docker (Phase 20) — optional; compose.yaml ships development-only defaults.
# WEB_URL: CORS origin the API allows (the web app's public origin).
# NEXT_PUBLIC_API_URL: browser-facing API URL, inlined into the web build.
# API_INTERNAL_URL: server-side (RSC) API URL used inside the compose network
# (e.g. http://api:4000/api/v1). Not needed for local non-Docker development.
# WEB_URL="http://localhost:3000"
# NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# API_INTERNAL_URL="http://api:4000/api/v1"
